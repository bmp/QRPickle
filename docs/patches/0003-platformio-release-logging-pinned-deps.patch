--- a/platformio.ini
+++ b/platformio.ini
@@ -10,7 +10,7 @@
 ; Configures ESP32 flashing speeds, dependencies (LVGL v9), and pre/post scripts
 ; ==============================================================================
 [env:cyd]
-platform              = espressif32 @ ^6.5.0
+platform              = espressif32 @ 6.13.0
 board                 = esp32dev
 framework             = arduino
 board_build.partitions= partitions.csv
@@ -19,23 +19,25 @@
 upload_speed          = 921600
 
 ; Project Application Library Dependencies
+; Pinned to the versions verified on hardware (review 6.2). Bump deliberately.
 lib_deps =
-    lvgl/lvgl @ ^9.2.0
-    bodmer/TFT_eSPI @ ^2.5.43
-    https://github.com/PaulStoffregen/XPT2046_Touchscreen.git
-    bblanchon/ArduinoJson @ ^7.0.4
-    ESP32Async/AsyncTCP @ ^3.2.0
-    ESP32Async/ESPAsyncWebServer @ ^3.6.0
-    adafruit/Adafruit BME280 Library @ ^2.2.4
-    adafruit/Adafruit Unified Sensor @ ^1.1.14
+    lvgl/lvgl @ 9.5.0
+    bodmer/TFT_eSPI @ 2.5.43
+    https://github.com/PaulStoffregen/XPT2046_Touchscreen.git#f956c5d8ce3bf39169c7378416b89e7cfe70a034
+    bblanchon/ArduinoJson @ 7.4.3
+    ESP32Async/AsyncTCP @ 3.4.10
+    ESP32Async/ESPAsyncWebServer @ 3.11.0
+    adafruit/Adafruit BME280 Library @ 2.3.0
+    adafruit/Adafruit Unified Sensor @ 1.1.15
 
 ; Compilation Build Flags:
-; - CORE_DEBUG_LEVEL=1: Shows essential system error messages over serial
+; - CORE_DEBUG_LEVEL=1: errors only. Level 4 logged full HTTP URLs incl. the OpenWeather key
+;   (review 3.5b) and costs ~12.6 KB flash; use the cyd-debug env for verbose logs.
 ; - USER_SETUP_LOADED=1: Informs TFT_eSPI to use an external configurations file
 ; - include: Directs the compiler to inject your custom hardware header file
 ; - LV_CONF_PATH: Explicitly points the engine to your LVGL configuration path
 build_flags =
-    -DCORE_DEBUG_LEVEL=4
+    -DCORE_DEBUG_LEVEL=1
     -DUSER_SETUP_LOADED=1
     -include "src/hw/User_Setup.h"
     -DLV_CONF_PATH=\"${PROJECT_DIR}/include/lv_conf.h\"
@@ -54,6 +56,14 @@
 check_flags =
     cppcheck: --suppress=preprocessorErrorDirective:*ArduinoJson*
 
+; Verbose framework logging for debugging only (never release this build).
+[env:cyd-debug]
+extends     = env:cyd
+build_flags =
+    ${env:cyd.build_flags}
+    -UCORE_DEBUG_LEVEL
+    -DCORE_DEBUG_LEVEL=4
+
 ; ==============================================================================
 ; Target Environment: Native Desktop Unit Testing
 ; Executes localized parsing, scheduling, and configuration verification logic
